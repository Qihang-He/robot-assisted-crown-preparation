# --- Python bytecode / caches -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Analysis outputs --------------------------------------------------------
# Everything written by the analysis scripts into DATA_ROOT.
/output/
analysis_results/
Region_Segmentation_Results/
Raw_Data/
