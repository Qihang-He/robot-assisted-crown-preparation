*.stl
*.STL
*.asc
*.tfm
*.ply
*.obj

# Data archives of the companion dataset deposit (not versioned here)
*_Raw_Scans.zip
*_Region_Segmentation.zip
*_Analysis_Results.zip
*_Supplementary_Materials.zip

